---
/**
 * The band across the top: the wordmark, the sections a reader jumps to, and
 * the three controls on the right.
 *
 * Starlight's own header centres the search field in a three-column grid and
 * carries no nav at all. This one is a flex row instead, because the nav sits
 * beside the wordmark and everything else sits at the end.
 */
import { readFileSync } from "node:fs";
import { dirname, join } from "node:path";

import config from "virtual:starlight/user-config";
import Search from "virtual:starlight/components/Search";
import SiteTitle from "virtual:starlight/components/SiteTitle";
import SocialIcons from "virtual:starlight/components/SocialIcons";
import ThemeSelect from "virtual:starlight/components/ThemeSelect";

/**
 * The workspace version, read from the manifest at build time so the badge
 * cannot drift from the crates it names.
 *
 * Found by walking up rather than by a fixed `../../..`: Astro rewrites
 * `import.meta.url` for a bundled component, so a counted path silently
 * resolves somewhere else.
 */
function workspaceVersion() {
  for (let dir = process.cwd(); ; dir = dirname(dir)) {
    try {
      const manifest = readFileSync(join(dir, "Cargo.toml"), "utf8");
      const after = manifest.split("[workspace.package]")[1];
      const found = after?.match(/version\s*=\s*"([^"]+)"/)?.[1];
      if (found) return found;
    } catch {
      // Not this directory's; keep climbing.
    }
    if (dirname(dir) === dir) {
      throw new Error("no Cargo.toml with a [workspace.package] version above " + process.cwd());
    }
  }
}

const version = workspaceVersion();

const REPO = "https://github.com/boxdesk/boxdesk/tree/main";

/**
 * The band's own shortcuts, for a reader who arrived with one question. Each
 * destination is a page or a directory that exists; the book's reading order
 * is the sidebar's job, not this one's.
 *
 * Reference is a menu because the four SDKs are not pages here: each is a
 * README beside the code it documents, which is the copy that cannot go stale
 * against it.
 */
const NAV = [
  { label: "Examples", href: "/examples/" },
  { label: "Architecture", href: "/architecture/" },
  {
    label: "Reference",
    items: [
      { label: "Rust SDK", href: `${REPO}/sdk/rust` },
      { label: "Python SDK", href: `${REPO}/sdk/python` },
      { label: "JavaScript SDK", href: `${REPO}/sdk/js` },
      { label: "Go SDK", href: `${REPO}/sdk/go` },
      { label: "CLI", href: "/running/#the-verbs", divide: true },
      { label: "Protocols", href: "/control-ipc/" },
    ],
  },
  { label: "Security", href: "/security/" },
];

const shouldRenderSearch =
  config.pagefind ||
  config.components.Search !== "@astrojs/starlight/components/Search.astro";
const here = Astro.url.pathname;
---

<div class="header sl-flex">
  <div class="start sl-flex">
    <div class="title-wrapper sl-flex"><SiteTitle /></div>
    <span class="slash" aria-hidden="true">/</span>
    <nav class="top-nav" aria-label="Sections">
      {
        NAV.map((entry) =>
          entry.items ? (
            <div class="menu-wrap">
              <button
                type="button"
                class="nav-item"
                aria-expanded="false"
                aria-controls={`menu-${entry.label.toLowerCase()}`}
              >
                {entry.label}
                <svg class="chev" viewBox="0 0 10 6" aria-hidden="true" focusable="false">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </button>
              <ul class="menu" id={`menu-${entry.label.toLowerCase()}`} hidden>
                {entry.items.map((item) => (
                  <li class={item.divide ? "divide" : undefined}>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              class="nav-item"
              href={entry.href}
              aria-current={here === entry.href ? "page" : undefined}
            >
              {entry.label}
            </a>
          )
        )
      }
    </nav>
  </div>

  <div class="end sl-flex">
    <span class="version">v{version}</span>
    <div class="search sl-flex print:hidden">{shouldRenderSearch && <Search />}</div>
    <div class="sl-hidden md:sl-flex print:hidden right-group">
      <div class="sl-flex social-icons"><SocialIcons /></div>
      <ThemeSelect />
    </div>
  </div>
</div>

<style>
  .header {
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-nav-gap);
    height: 100%;
  }

  .start,
  .end {
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  /* The wordmark is the one thing that never gives up room: everything else
     in the row leaves before it is allowed to clip. */
  .title-wrapper {
    flex-shrink: 0;
    /* Room for the focus ring. */
    padding: 0.25rem;
    margin: -0.25rem;
  }

  .slash {
    display: none;
    color: var(--sl-color-gray-4);
    font-family: var(--sl-font-mono);
    user-select: none;
  }

  /* The sections read as labels rather than as prose: mono, small, spaced, and
     the body's colour only once the pointer is on one. */
  .top-nav {
    display: none;
    gap: 1.25rem;
    align-items: center;
  }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .nav-item:hover,
  .nav-item[aria-current="page"],
  .nav-item[aria-expanded="true"] {
    color: var(--sl-color-white);
  }

  .chev {
    width: 0.625rem;
    height: 0.375rem;
    transition: transform 0.15s;
  }
  .nav-item[aria-expanded="true"] .chev {
    transform: rotate(180deg);
  }

  .menu-wrap {
    position: relative;
  }

  /* The menu hangs off the band on the surface a raised thing wears, held by
     the same hairline every other edge is drawn in. */
  .menu {
    position: absolute;
    inset-block-start: calc(100% + 0.75rem);
    inset-inline-start: -0.75rem;
    z-index: 1;
    min-inline-size: 13rem;
    margin: 0;
    padding: 0.35rem 0;
    list-style: none;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-hairline);
  }
  .menu[hidden] {
    display: none;
  }
  .menu li.divide {
    margin-block-start: 0.35rem;
    border-block-start: 1px solid var(--sl-color-hairline);
    padding-block-start: 0.35rem;
  }
  .menu a {
    display: block;
    padding: 0.4rem 0.9rem;
    color: var(--sl-color-gray-2);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    text-decoration: none;
    white-space: nowrap;
  }
  .menu a:hover,
  .menu a:focus-visible {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-white);
  }

  .version {
    display: none;
    color: var(--sl-color-gray-3);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    white-space: nowrap;
  }

  /* Starlight's search grows to its container; at the end of a row it should
     take only what it needs. */
  .search {
    max-inline-size: 16rem;
    inline-size: 100%;
  }

  .right-group {
    gap: 1rem;
    align-items: center;
  }
  .social-icons {
    gap: 1rem;
    align-items: center;
  }
  .social-icons::after {
    content: "";
    height: 2rem;
    border-inline-end: 1px solid var(--sl-color-gray-5);
  }

  /* Two widths, each the one at which the thing it shows stops crowding the
     search field. Starlight's `md:` is 50rem, which is too early for both. */
  @media (min-width: 60rem) {
    .version {
      display: flex;
    }
  }
  @media (min-width: 64rem) {
    .slash,
    .top-nav {
      display: flex;
    }
  }
</style>

<script>
  // A disclosure, not a menubar: the contents are links, so the button only
  // has to open the list and hand the keyboard back. Escape and a press
  // outside close it, because a panel with no way out is the one bug every
  // hand-written dropdown ships with.
  for (const button of document.querySelectorAll<HTMLButtonElement>(".top-nav .nav-item[aria-controls]")) {
    const menu = document.getElementById(button.getAttribute("aria-controls")!);
    if (!menu) continue;

    const setOpen = (open: boolean) => {
      button.setAttribute("aria-expanded", String(open));
      menu.hidden = !open;
    };

    button.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });
    menu.addEventListener("click", (event) => event.stopPropagation());
    document.addEventListener("click", () => setOpen(false));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && button.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
